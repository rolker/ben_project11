Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Polygon1
        - /Polygon1/Topic1
        - /Sonar GridMap1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 2194
  - Class: rviz_common/Selection
